    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "react-window": "^2.3.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
