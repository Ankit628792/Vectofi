  },
  "license": "MIT",
  "keywords": [
    "svg",
    "icons",
    "animated-icons",
    "vector-icons",
    "react-icons",
    "vue-icons",
    "svelte-icons",
    "icon-library",
    "svg-laboratory",
    "developer-tools",
    "vector-art",
    "tailwind"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/generate-sitemap.ts --outDir=dist",
