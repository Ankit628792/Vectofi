{
  "name": "vectofi",
  "version": "2.5.1",
  "description": "Developer-first SVG icon library with 17,000+ static and animated vector icons across 20 categories, interactive SVG laboratory, framework code generators, and vector art design system.",
  "private": true,
  "type": "module",
  "author": "Ankit Kumar <ankit628792@gmail.com> (https://www.instagram.com/ankit_628792)",
  "homepage": "https://vectofi.vercel.app",
